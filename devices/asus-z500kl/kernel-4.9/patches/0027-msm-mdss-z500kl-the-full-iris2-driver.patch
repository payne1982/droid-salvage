Subject: [PATCH] msm: mdss: Z500KL: the full iris2 driver

Hooks of ASUS' full Pixelworks iris2 driver in this MDSS: exclusive full and light
selection, panel on and off, DT parsing, a 64 KiB TX buffer for its firmware, metadata
in command-mode frames, and quiescing before off and mode changes. The driver and its
lifecycle are in files/drivers/video/fbdev/msm/iris2/, its ioctls in
files/include/uapi/linux/msm_iris2.h.

The firmware goes to the bridge's RAM at each power-on, on the first unblank as on
3.10. EFUSE_REWRITE is left out: the sequence is not sent to the IRIS2_26 of this
tablet in any case, and nothing here should go near the chip's fuses.
---
--- drivers/video/fbdev/msm/Kconfig
+++ drivers/video/fbdev/msm/Kconfig
@@ -144,13 +144,21 @@
 	statistics and check whether its output pattern matches expected
 	cadence.
 
+choice
+	prompt "Pixelworks Iris2 bridge support"
+	depends on FB_MSM_MDSS
+	optional
+
 config IRIS2_LIGHTUP_ONLY
-	depends on FB_MSM_MDSS
-	bool "Pixelworks iris2 display bridge, light-up only"
-	---help---
-	Power, reset and program a Pixelworks iris2 that sits between the DSI
-	controllers and the panel, so that it passes the picture through. As
-	on the ASUS ZenPad 3S 10 (Z500KL).
+	bool "Light-up and pass-through only"
+
+config IRIS2_FULL_SUPPORT
+	bool "Full Iris2 support (experimental Z500KL port)"
+	help
+	  Includes firmware download, image processing, metadata and mode changes.
+	  Experimental: compile checked, not validated on hardware.
+
+endchoice
 
 config BACKLIGHT_LP8557E01
 	depends on FB_MSM_MDSS && I2C
--- drivers/video/fbdev/msm/Makefile
+++ drivers/video/fbdev/msm/Makefile
@@ -44,8 +44,18 @@
 mdss-dsi-objs += mdss_dsi_phy_12nm.o
 mdss-dsi-objs += mdss_dsi_clk.o
 mdss-dsi-objs-$(CONFIG_IRIS2_LIGHTUP_ONLY) += mdss_dsi_iris2_lightup_only.o
+mdss-dsi-objs-$(CONFIG_IRIS2_FULL_SUPPORT) += iris2/iris2_mdss.o iris2/iris2_lifecycle.o
+mdss-dsi-objs-$(CONFIG_IRIS2_FULL_SUPPORT) += iris2/mdss_dsi_iris2_def.o iris2/mdss_dsi_iris2.o
+mdss-dsi-objs-$(CONFIG_IRIS2_FULL_SUPPORT) += iris2/mdss_dsi_iris2_lightup.o iris2/mdss_dsi_iris2_ioctl.o
+mdss-dsi-objs-$(CONFIG_IRIS2_FULL_SUPPORT) += iris2/mdss_dsi_iris2_mode_switch.o iris2/mdss_dsi_iris2_dbg.o
+ifeq ($(CONFIG_IRIS2_FULL_SUPPORT),y)
+ccflags-y += -I$(src) -I$(src)/iris2
+endif
+# Expand the selected, mutually exclusive implementation once.
 mdss-dsi-objs += $(mdss-dsi-objs-y)
-obj-$(CONFIG_IRIS2_LIGHTUP_ONLY) += iris2_io.o
+ifneq ($(filter y,$(CONFIG_IRIS2_LIGHTUP_ONLY) $(CONFIG_IRIS2_FULL_SUPPORT)),)
+obj-y += iris2_io.o
+endif
 obj-$(CONFIG_BACKLIGHT_LP8557E01) += lp8557e01.o
 obj-$(CONFIG_FB_MSM_MDSS) += mdss-dsi.o
 obj-$(CONFIG_FB_MSM_MDSS) += mdss_panel.o
