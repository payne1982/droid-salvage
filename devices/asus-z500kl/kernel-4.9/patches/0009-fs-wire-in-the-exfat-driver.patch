Subject: [PATCH] fs: wire in the exFAT driver

tools/setup-kernel.sh puts exfat-nofuse in fs/exfat, as for the 3.10 kernel
(../kernel/patches/0013): microSD cards over 32 GB come formatted exFAT, and
Android's vold formats them so too. Linux has its own exFAT driver only from 5.4.
---
--- fs/Kconfig
+++ fs/Kconfig
@@ -125,6 +125,7 @@
 menu "DOS/FAT/NT Filesystems"
 
 source "fs/fat/Kconfig"
+source "fs/exfat/Kconfig"
 source "fs/ntfs/Kconfig"
 
 endmenu
--- fs/Makefile
+++ fs/Makefile
@@ -78,6 +78,7 @@
 obj-$(CONFIG_CODA_FS)		+= coda/
 obj-$(CONFIG_MINIX_FS)		+= minix/
 obj-$(CONFIG_FAT_FS)		+= fat/
+obj-$(CONFIG_EXFAT_FS)		+= exfat/
 obj-$(CONFIG_BFS_FS)		+= bfs/
 obj-$(CONFIG_ISO9660_FS)	+= isofs/
 obj-$(CONFIG_HFSPLUS_FS)	+= hfsplus/ # Before hfs to find wrapped HFS+
