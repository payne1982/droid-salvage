Subject: [PATCH] firmware_class: read firmware with the kernel's credentials

A driver often asks for its firmware while serving a request from user space,
the GPU's when the composer opens it, the Wi-Fi core's when the Wi-Fi HAL
starts it. The file was then opened as that process, and SELinux, which lets
the kernel read firmware but not those HALs, refused it. Read as the kernel,
as upstream does since "firmware_loader: use kernel credentials when reading
firmware"; as in ../kernel/patches/0023, only the read from the file system.
---
--- drivers/base/firmware_class.c
+++ drivers/base/firmware_class.c
@@ -19,6 +19,7 @@
 #include <linux/workqueue.h>
 #include <linux/highmem.h>
 #include <linux/firmware.h>
+#include <linux/cred.h>
 #include <linux/slab.h>
 #include <linux/sched.h>
 #include <linux/file.h>
@@ -330,6 +331,8 @@
 	char *path;
 	enum kernel_read_file_id id = READING_FIRMWARE;
 	size_t msize = INT_MAX;
+	struct cred *kern_cred;
+	const struct cred *old_cred;
 
 	/* Already populated data member means we're loading into a buffer */
 	if (buf->data) {
@@ -341,6 +344,17 @@
 	if (!path)
 		return -ENOMEM;
 
+	/*
+	 * Read as the kernel, not as whichever process made the driver ask:
+	 * SELinux lets the kernel read firmware files, not every HAL.
+	 */
+	kern_cred = prepare_kernel_cred(NULL);
+	if (!kern_cred) {
+		__putname(path);
+		return -ENOMEM;
+	}
+	old_cred = override_creds(kern_cred);
+
 	for (i = 0; i < ARRAY_SIZE(fw_path); i++) {
 		/* skip the unset customized path */
 		if (!fw_path[i][0])
@@ -370,6 +384,8 @@
 		fw_finish_direct_load(device, buf);
 		break;
 	}
+	revert_creds(old_cred);
+	put_cred(kern_cred);
 	__putname(path);
 
 	return rc;
