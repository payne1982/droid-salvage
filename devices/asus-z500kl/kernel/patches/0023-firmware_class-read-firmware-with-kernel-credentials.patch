Subject: [PATCH] firmware_class: read firmware with the kernel's credentials

A driver often asks for its firmware while serving a request from user space: the
GPU's when the composer HAL opens it, the WiFi core's when the WiFi HAL starts it.
The file was then opened as that process, and SELinux, which lets the kernel read
firmware files but not those HALs, refused it; the kernel fell back to asking ueventd
with a uevent. Read as the kernel, the file is found where patches/0022 points, and no
policy for any of those processes has to change.

Upstream did the same in "firmware_loader: use kernel credentials when reading
firmware", for the same reason on Android. Only the read from the file system is done
with the kernel's credentials here; the fallback to ueventd is as it was.
---
--- drivers/base/firmware_class.c
+++ drivers/base/firmware_class.c
@@ -8,6 +8,7 @@
  */
 
 #include <linux/capability.h>
+#include <linux/cred.h>
 #include <linux/device.h>
 #include <linux/module.h>
 #include <linux/init.h>
@@ -1230,8 +1231,11 @@
 static int _request_firmware(struct fw_desc *desc)
 {
 	struct firmware *fw;
+	const struct cred *old_cred;
+	struct cred *kern_cred;
 	long timeout;
 	int ret;
+	bool found;
 
 	if (!desc->firmware_p)
 		return -EINVAL;
@@ -1259,8 +1263,25 @@
 		}
 	}
 
-	if (!fw_get_filesystem_firmware(desc->device, fw->priv,
-					desc->dest_addr, desc->dest_size))
+	/*
+	 * A driver may ask for firmware while serving an unrelated request from user
+	 * space; read the file as the kernel, not as that process, which the security
+	 * policy may not let read it. As upstream does since "firmware_loader: use
+	 * kernel credentials when reading firmware".
+	 */
+	kern_cred = prepare_kernel_cred(NULL);
+	if (!kern_cred) {
+		usermodehelper_read_unlock();
+		ret = -ENOMEM;
+		goto out;
+	}
+	old_cred = override_creds(kern_cred);
+	found = fw_get_filesystem_firmware(desc->device, fw->priv,
+					   desc->dest_addr, desc->dest_size);
+	revert_creds(old_cred);
+	put_cred(kern_cred);
+
+	if (!found)
 		ret = fw_load_from_user_helper(fw, desc, timeout);
 	if (!ret)
 		ret = assign_firmware_buf(fw, desc->device, desc->nocache);
