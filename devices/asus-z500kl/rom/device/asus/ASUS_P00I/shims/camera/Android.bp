// android::Fence as ASUS' Nougat camera HAL (camera.msm8952.so) uses it; fence.cpp says
// why. Loaded into the HAL's process through TARGET_LD_SHIM_LIBS (BoardConfig.mk).
cc_library_shared {
    name: "libshim_camera",
    srcs: ["fence.cpp"],
    shared_libs: ["libsync"],
    compile_multilib: "32",
}
