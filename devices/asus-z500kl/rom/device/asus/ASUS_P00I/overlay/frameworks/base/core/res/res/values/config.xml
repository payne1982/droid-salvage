<?xml version="1.0" encoding="utf-8"?>
<!--
     ASUS_P00I framework overlay. Each value is here because the hardware reports
     something the framework would otherwise not listen to.
-->
<resources>
    <!-- The headset jack is reported as an input device, "msm8952-snd-card Headset
         Jack", with SW_HEADPHONE_INSERT and SW_MICROPHONE_INSERT. There is no
         switch/h2w, which is what the framework watches by default, so without this
         a plugged headset went unnoticed and sound stayed on the speaker. -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- The magnet in the cover: "lid_input" reports SW_LID. Closing the cover
         turns the screen off, opening it turns it back on. -->
    <bool name="config_lidControlsSleep">true</bool>

    <!-- Automatic brightness, with ASUS' curve for this panel from the stock
         framework-res: lux thresholds, and the backlight level below the first, between
         each pair and above the last (one more entry than the thresholds). Stock's last
         four levels went past 255 (319-510), ASUS' sunlight boost; Pie clamps backlight
         values to 255, so they are written as 255 here. Without these the framework
         treats the light sensor as absent for brightness and offers no auto toggle. -->
    <bool name="config_automatic_brightness_available">true</bool>
    <integer-array name="config_autoBrightnessLevels">
        <item>50</item>
        <item>100</item>
        <item>200</item>
        <item>300</item>
        <item>400</item>
        <item>500</item>
        <item>650</item>
        <item>800</item>
        <item>1000</item>
        <item>1500</item>
        <item>2000</item>
        <item>3000</item>
        <item>4000</item>
        <item>5000</item>
        <item>7000</item>
        <item>10000</item>
        <item>12500</item>
        <item>15000</item>
        <item>17500</item>
        <item>20000</item>
    </integer-array>
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>10</item>
        <item>45</item>
        <item>66</item>
        <item>84</item>
        <item>95</item>
        <item>104</item>
        <item>111</item>
        <item>121</item>
        <item>131</item>
        <item>142</item>
        <item>182</item>
        <item>210</item>
        <item>233</item>
        <item>243</item>
        <item>248</item>
        <item>251</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
    </integer-array>
    <integer name="config_screenBrightnessSettingMinimum">4</integer>
    <integer name="config_screenBrightnessSettingDefault">60</integer>
    <integer name="config_screenBrightnessDim">10</integer>

    <!-- Wi-Fi, as stock's framework-res has them. The first is what lets Android hand
         the search for a known network to the chip while the tablet sleeps (PNO, a
         scheduled scan in prima). Without it every such request was refused as "not
         supported" and retried with a wake-up alarm, about every six seconds for as
         long as Wi-Fi was disconnected with the screen off: 2600 wake-ups in one night,
         and no reconnection until a 20-minute watchdog ran an ordinary scan. -->
    <bool name="config_wifi_background_scan_support">true</bool>
    <bool name="config_wifi_dual_band_support">true</bool>

    <!-- A SIM gives this tablet mobile data and SMS, not voice calls. The modem is
         registered for voice on the network, but it answers a dial request with
         QMI_ERR_INVALID_ARG within 30 ms, before trying the network, on 3G and on LTE
         alike, and an incoming call never reaches Android (the caller hears busy).
         ASUS sold the tablet without a phone function and stock had no dialer. This
         is what the framework and the apps ask before they offer a call: the lock
         screen's emergency button, Contacts, Messaging. -->
    <bool name="config_voice_capable">false</bool>

    <!-- GPS parameters. The framework reads these, not the HAL's /etc/gps.conf, and
         pushes them down to the HAL at start, overriding what gps.conf says; so they
         are ASUS' gps.conf values, not AOSP's defaults (which differ in SUPL_MODE and
         the GLONASS protocol). The XTRA servers are also how the framework knows where
         to download the satellite orbit predictions the modem asks for; without them
         it logged "No XTRA servers were specified" and every start was a cold one.
         https rather than gps.conf's http: the same files, checked on all three. -->
    <string-array translatable="false" name="config_gpsParameters">
        <item>XTRA_SERVER_1=https://xtrapath1.izatcloud.net/xtra3grc.bin</item>
        <item>XTRA_SERVER_2=https://xtrapath2.izatcloud.net/xtra3grc.bin</item>
        <item>XTRA_SERVER_3=https://xtrapath3.izatcloud.net/xtra3grc.bin</item>
        <item>NTP_SERVER=time.izatcloud.net</item>
        <item>SUPL_HOST=supl.google.com</item>
        <item>SUPL_PORT=7275</item>
        <item>SUPL_VER=0x20000</item>
        <item>SUPL_ES=1</item>
        <item>USE_EMERGENCY_PDN_FOR_EMERGENCY_SUPL=1</item>
        <item>LPP_PROFILE=0</item>
        <item>A_GLONASS_POS_PROTOCOL_SELECT=0x6</item>
    </string-array>
</resources>
