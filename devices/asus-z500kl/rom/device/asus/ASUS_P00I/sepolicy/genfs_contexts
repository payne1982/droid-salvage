# CPU and bus tuning written by init.qcom.rc at boot_completed: the HMP scheduler
# knobs and the CPU-to-DDR bandwidth governor. (The low-power modes switch,
# /sys/module/lpm_levels, is sepolicy-legacy's sysfs_msm_power already.)
genfscon proc /sys/kernel/sched_                                    u:object_r:proc_sched:s0
genfscon proc /sys/kernel/power_aware_timer_migration               u:object_r:proc_sched:s0
genfscon sysfs /devices/soc.0/qcom,cpubw.49/devfreq                  u:object_r:sysfs_devfreq:s0
genfscon sysfs /devices/soc.0/qcom,mincpubw.50/devfreq               u:object_r:sysfs_devfreq:s0

# Where init.macaddr.sh hands the WCNSS core the factory WiFi address.
genfscon sysfs /devices/soc.0/a000000.qcom,wcnss-wlan/wcnss_mac_addr u:object_r:sysfs_wcnss_mac_addr:s0

# Every power supply on this board (/sys/class/power_supply), which healthd reads
# with the battery's: the current limiter, the fuel gauge's ADC, the pen, the type-C
# port and its power delivery, and the parallel charger. The battery, bms and usb
# ones are labelled already.
genfscon sysfs /devices/soc.0/qcom,bcl.56/power_supply               u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/soc.0/msm-bcl-20/power_supply                u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/soc.0/78b8000.i2c/i2c-4/4-004a/power_supply  u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/soc.0/78b6000.i2c/i2c-2/2-006a/power_supply  u:object_r:sysfs_batteryinfo:s0
# The parallel charger's name (smb1351-charger), which hvdcp_opti reads at start; when it
# cannot, it sleeps for good and never steps a Quick Charge 3 adapter.
genfscon sysfs /devices/soc.0/78b6000.i2c/i2c-2/2-006a/name          u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/virtual/typec/typec_device/typec             u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/virtual/typec/typec_device/power_delivery    u:object_r:sysfs_batteryinfo:s0

# ASUS' camera module OTP data, read by the camera daemon's AF and AWB.
genfscon proc /rear_otp                                              u:object_r:proc_camera_otp:s0
genfscon proc /front_otp                                             u:object_r:proc_camera_otp:s0
# The two settings of the eMMC's block queue that are written at boot: discard_max_bytes
# by AOSP's init.rc (init.te), the read-ahead by vold, which may write this type
# already. AOSP's type for them; only the files, since storaged walks these directories
# and a vendor policy cannot give it a type it has no rule for.
genfscon sysfs /devices/soc.0/7824900.sdhci/mmc_host/mmc0/mmc0:0001/block/mmcblk0/queue/discard_max_bytes   u:object_r:sysfs_devices_block:s0
genfscon sysfs /devices/soc.0/7824900.sdhci/mmc_host/mmc0/mmc0:0001/block/mmcblk0/queue/read_ahead_kb       u:object_r:sysfs_devices_block:s0
# See file.te.
genfscon proc /sys/net/ipv4/tcp_limit_output_bytes                         u:object_r:proc_wifi_tcp_tuning:s0
genfscon proc /sys/net/ipv4/tcp_adv_win_scale                              u:object_r:proc_wifi_tcp_tuning:s0
genfscon proc /sys/net/ipv4/tcp_use_userconfig                             u:object_r:proc_wifi_tcp_tuning:s0
# The two PMICs' ADCs. hvdcp_opti opens each to find the one with usbin, the input
# voltage it watches while it steps a Quick Charge 3 adapter (hvdcp.te in sepolicy-legacy).
genfscon sysfs /devices/soc.0/qpnp-vadc-6                            u:object_r:sysfs_vadc_dev:s0
genfscon sysfs /devices/soc.0/qpnp-vadc-15                           u:object_r:sysfs_vadc_dev:s0

# The PMIC's clock, where /sys/class/rtc/rtc0 points: AOSP labels only the class
# directory itself sysfs_rtc. timekeep and its receiver read since_epoch here.
genfscon sysfs /devices/soc.0/qpnp-rtc-8/rtc                        u:object_r:sysfs_rtc:s0
