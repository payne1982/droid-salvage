// The health HAL with this board's healthd_board_init() and battery update; see
// HealthService.cpp.
cc_binary {
    name: "android.hardware.health@2.0-service.ASUS_P00I",
    init_rc: ["android.hardware.health@2.0-service.ASUS_P00I.rc"],
    proprietary: true,
    relative_install_path: "hw",
    srcs: ["HealthService.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    static_libs: [
        "android.hardware.health@2.0-impl",
        "android.hardware.health@1.0-convert",
        "libhealthservice",
        "libbatterymonitor",
        "libhealthstoragedefault",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.health@2.0",
    ],
    header_libs: ["libhealthd_headers"],
}
