#
# ASUS ZenPad 3S 10 LTE (Z500KL / ASUS_P00I)
#
# This is the first cut, aimed at M3 in ../../../../ROADMAP.md: a boot that can be
# watched rather than a usable tablet. What is in here is what is needed for init to
# run, something to appear on screen, and /data to be decrypted and mounted. The
# subsystems that come afterwards are listed at the bottom rather than guessed at, so
# that nothing carries a wrong value into a first boot where every symptom has a dozen
# candidate causes.
#

DEVICE_PATH := device/asus/ASUS_P00I

# The vendor blobs, generated by extract-files.sh from your own tablet.
$(call inherit-product-if-exists, vendor/asus/ASUS_P00I/ASUS_P00I-vendor.mk)

# Framework resource overrides; overlay/ says why for each value.
DEVICE_PACKAGE_OVERLAYS += $(DEVICE_PATH)/overlay

# Dalvik/ART heap: AOSP's profile for 10" xhdpi 2048 px tablets, which are this
# tablet's numbers, and the values stock had. Without any, every app got the 16 MB
# default and anything bigger died of OutOfMemoryError (F-Droid, on first launch).
$(call inherit-product, frameworks/native/build/tablet-10in-xhdpi-2048-dalvik-heap.mk)

# HWUI caches, stock's values (AOSP has no 10" profile for these).
PRODUCT_PROPERTY_OVERRIDES += \
    ro.hwui.texture_cache_size=72 \
    ro.hwui.layer_cache_size=48 \
    ro.hwui.r_buffer_cache_size=8 \
    ro.hwui.path_cache_size=32 \
    ro.hwui.gradient_cache_size=1 \
    ro.hwui.drop_shadow_cache_size=6 \
    ro.hwui.texture_cache_flushrate=0.4 \
    ro.hwui.text_small_cache_width=1024 \
    ro.hwui.text_small_cache_height=1024 \
    ro.hwui.text_large_cache_width=2048 \
    ro.hwui.text_large_cache_height=2048

# A 2048x1536 tablet at 320 dpi.
PRODUCT_CHARACTERISTICS := tablet
PRODUCT_AAPT_CONFIG := normal
PRODUCT_AAPT_PREF_CONFIG := xhdpi

# Android 13's SurfaceFlinger wants the density as a build property and says so in the
# log when it is missing ("ro.sf.lcd_density must be defined as a build property").
PRODUCT_PROPERTY_OVERRIDES += \
    ro.sf.lcd_density=320

# The OpenGL ES version the GPU has, 3.2 (0x30002), stock's value. Without it Android
# reports no version to apps (reqGlEsVersion 0), and the Play Store calls the device
# incompatible with anything that asks for 2.0 or more, Chrome and YouTube among them,
# and hides it from search.
PRODUCT_PROPERTY_OVERRIDES += \
    ro.opengles.version=196610

# SurfaceFlinger compiles its Skia shaders ahead of time when it starts, and one of the
# sample textures it draws for that is RGBA_FP16. The Adreno 510 driver of 2017 does
# not make a texture of it ("Failed to create a valid texture ... format:22"), the
# render engine aborts, and SurfaceFlinger takes zygote down with it every 18 seconds.
# Without the priming the shaders are compiled when first used.
PRODUCT_PROPERTY_OVERRIDES += \
    service.sf.prime_shader_cache=0

# ---------------------------------------------------------------------------------
# rootdir
# ---------------------------------------------------------------------------------
# The fstab is ours, rewritten from the stock one (see the file for
# the two deliberate differences). The stock init.qcom.rc, init.target.rc,
# init.qcom.usb.rc and ueventd.qcom.rc are ASUS' own and come off the device with
# extract-files.sh rather than being committed here, the same rule the recovery tree
# follows. They will need adapting: they are written for Nougat's init, and Pie's is
# stricter about what it accepts.
# $(TARGET_COPY_OUT_ROOT) and not $(TARGET_COPY_OUT_RAMDISK): on this tree the latter is
# *empty* -- it exists for A/B and system-as-root layouts, and this device is neither --
# so a destination built from it expands to "/fstab.qcom" and the file silently lands
# nowhere. The first build produced a ramdisk of 59 entries with no fstab in it, and
# nothing complained.
#
# Android 13: init's second stage lives in /system, so the first stage, which is all
# the ramdisk holds now, has to mount /system itself, and it reads the fstab from the
# ramdisk to do it (the entry marked first_stage_mount). The copy under /vendor/etc is
# the one mount_all and vold read once /system is there. TARGET_COPY_OUT_RAMDISK is no
# longer empty on this tree.
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/rootdir/etc/fstab.qcom:$(TARGET_COPY_OUT_RAMDISK)/fstab.qcom \
    $(DEVICE_PATH)/rootdir/etc/fstab.qcom:$(TARGET_COPY_OUT_VENDOR)/etc/fstab.qcom

# ASUS' own init scripts are extracted into rootdir/etc by extract-files.sh but are
# deliberately NOT installed. They are 150 KB written for Nougat's init, and a first
# boot with all of them in would produce a wall of init errors in which nothing can be
# told apart.
#
# The device init is ours instead, in rootdir/init, and grows a subsystem at a time.
# "AOSP's init alone" was the first plan and it does not boot: the core init.rc leaves
# mount_all to init.${ro.hardware}.rc, so without one nothing is mounted and the tablet
# sits on the bootloader logo (first M3 attempt, see init.qcom.rc).
#
# Android 13 imports /vendor/etc/init/hw/init.${ro.hardware}.rc; nothing of the device
# goes in the root directory any more.
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/rootdir/init/init.qcom.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.qcom.rc \
    $(DEVICE_PATH)/rootdir/init/init.qcom.usb.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.qcom.usb.rc

# Bring-up builds only do anything with this one: see the file.
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/rootdir/init/init.p00i.bringup.rc:$(TARGET_COPY_OUT_SYSTEM)/etc/init/init.p00i.bringup.rc

# ueventd.qcom.rc is the one ASUS file installed as it is: a plain table of device node
# owners and modes (kgsl, camera, video, audio, sensors...), no commands, nothing that
# depends on the init version. Without it every Qualcomm node is root-only and the
# HALs, which run as system/media/camera, cannot open their hardware. It comes from
# extract-files.sh; the wildcard keeps a tree that has not run it buildable.
# Android 13's ueventd reads /vendor/ueventd.rc, whatever ro.hardware is.
PRODUCT_COPY_FILES += $(foreach f,$(wildcard $(DEVICE_PATH)/rootdir/etc/ueventd.qcom.rc), \
    $(f):$(TARGET_COPY_OUT_VENDOR)/ueventd.rc)

# Process groups. Android 13 keeps one cgroup per app process (uid_*/pid_*) in the
# cgroup v2 hierarchy, and kills an app by killing what its cgroup.procs lists. A 3.10
# kernel has no cgroup v2: tools/tree-patches/system/core/0001 mounts a v1 hierarchy
# (cpuacct, as /acct was in Android 9) in its place. LineageOS-UL's cgroups.json
# gives that directory mode 0600 and root, as it held only BPF programs there; this
# replaces the entry with what AOSP gives /sys/fs/cgroup, so that system_server can
# read and remove the groups.
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/cgroups/cgroups.json:$(TARGET_COPY_OUT_VENDOR)/etc/cgroups.json

# ---------------------------------------------------------------------------------
# Boot image signature
# ---------------------------------------------------------------------------------
# The bootloader refuses a boot image without an AVB1 signature naming the partition
# -- it is how the recovery had to be signed with magiskboot -- and the first complete
# build produced boot.img with no signature at all: written as it was, the tablet would
# not have booted it. boot_signer appends exactly that BootSignature, with target
# "/boot" (build/make/core/Makefile). The bootloader does not pin a key, so the public
# AOSP verity test key is the right one, as it was for the recovery.
#
# Set directly rather than by inheriting target/product/verity.mk, which would also
# switch on PRODUCT_SUPPORTS_VERITY: dm-verity on /system is exactly what we removed
# from the fstab, and what made a read-write mount enough to stop stock Android booting.
PRODUCT_SUPPORTS_BOOT_SIGNER := true
PRODUCT_VERITY_SIGNING_KEY := build/target/product/security/verity

# ---------------------------------------------------------------------------------
# Graphics
# ---------------------------------------------------------------------------------
# hwcomposer.msm8952 from display-caf/msm8952 is HWC1 (HWC_DEVICE_API_VERSION_1_5),
# which is a generation behind what Pie expects. No flag is needed for that: the AOSP
# composer@2.1 default implementation links libhwc2on1adapter unconditionally and wraps
# an HWC1 HAL by itself.
#
# Android 13: the composer service has the passthrough implementation built in (there
# is no separate -impl), and the mapper wrapper is the 2.1 one. copybit.msm8952 and
# libgenlock, in this list on LineageOS 16, are not built by this version of the
# display tree, and Android 13 stops on a package that does not exist.
PRODUCT_PACKAGES += \
    android.hardware.graphics.allocator@2.0-impl \
    android.hardware.graphics.allocator@2.0-service \
    android.hardware.graphics.composer@2.1-service \
    android.hardware.graphics.mapper@2.0-impl-2.1 \
    android.hardware.memtrack@1.0-impl \
    android.hardware.memtrack@1.0-service \
    gralloc.msm8952 \
    hwcomposer.msm8952 \
    liboverlay \
    libqdMetaData \
    libqdutils \
    libtinyxml \
    memtrack.msm8952

# ---------------------------------------------------------------------------------
# Keymaster and gatekeeper -- the decryption path
# ---------------------------------------------------------------------------------
# keymaster@3.0-impl loads its backend through hw_get_module_by_class, which tries
# keystore.$(ro.hardware).so, then $(ro.product.board), then $(ro.board.platform), then
# default. ro.board.platform is msm8952, so it finds the real keystore.msm8952.so.
#
# This is not theory: getting it wrong is what made the stock vold load the *software*
# keymaster while bringing up decryption in the recovery, and the TrustZone then
# rejected a correct PIN with -71 INCORRECT_PSWD. Two properties fixed it there, and the
# same mechanism applies here.
PRODUCT_PACKAGES += \
    android.hardware.keymaster@3.0-impl \
    android.hardware.keymaster@3.0-service \
    android.hardware.gatekeeper@1.0-impl \
    android.hardware.gatekeeper@1.0-service

# keymaster@3.0 is no longer in AOSP at this version; the wrapper around a legacy
# keystore module survives in LineageOS-UL's hardware/interfaces. libcryptfs_hw, the
# vendor side of hardware full-disk encryption, is gone with FDE (BoardConfig.mk).

# ---------------------------------------------------------------------------------
# DRM
# ---------------------------------------------------------------------------------
# AOSP's DRM service for plugins of the old kind, which is what stock's Widevine is:
# it loads whatever it finds in vendor/lib/mediadrm. The Widevine plugin itself and
# its TrustZone half are blobs (proprietary-files.txt). 32-bit, like the plugin.
PRODUCT_PACKAGES += \
    android.hardware.drm@1.0-impl \
    android.hardware.drm@1.0-service

# ---------------------------------------------------------------------------------
# Health. AOSP's service with this board's paths for the charge counter and the full
# charge, which live in the fuel gauge and not in the battery supply (health/).
# ---------------------------------------------------------------------------------
PRODUCT_PACKAGES += \
    android.hardware.health@2.0-service.ASUS_P00I

# ---------------------------------------------------------------------------------
# Lights and power
# ---------------------------------------------------------------------------------
PRODUCT_PACKAGES += \
    android.hardware.light@2.0-impl \
    android.hardware.light@2.0-service \
    android.hardware.power@1.0-impl \
    android.hardware.power@1.0-service \
    lights.msm8952

# ---------------------------------------------------------------------------------
# Platform features
# ---------------------------------------------------------------------------------
# Only what something already backs. A feature declared here tells apps and the
# framework the hardware is there, so camera, sensors, location, telephony and
# bluetooth come with their own blocks rather than ahead of them.
#
# wifi is the exception, and on purpose: SystemServer starts the wifi service only when
# android.hardware.wifi is declared, and com.android.phone, which is persistent, calls
# WifiManager.createWifiLock() at startup without a null check. Without it the phone
# process crash-looped on the first boot that reached the launcher. With the feature
# and no driver yet, wifi simply fails to switch on.
#
# tablet_core_hardware.xml declares bluetooth, compass and accelerometer, so it went in
# only once their HALs did (it was a trimmed copy until then); the sensor features
# below are the ones the sensors HAL reports on this tablet: Invensense accelerometer
# and gyroscope, AKM AK09916 magnetometer, Lite-On AL3320B light sensor, and the step
# sensors Qualcomm's fusion provides. No proximity or barometer on this tablet.
PRODUCT_COPY_FILES += \
    frameworks/native/data/etc/tablet_core_hardware.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/tablet_core_hardware.xml \
    frameworks/native/data/etc/android.hardware.sensor.gyroscope.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.sensor.gyroscope.xml \
    frameworks/native/data/etc/android.hardware.sensor.light.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.sensor.light.xml \
    frameworks/native/data/etc/android.hardware.sensor.stepcounter.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.sensor.stepcounter.xml \
    frameworks/native/data/etc/android.hardware.sensor.stepdetector.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.sensor.stepdetector.xml \
    frameworks/native/data/etc/android.hardware.touchscreen.multitouch.jazzhand.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.touchscreen.multitouch.jazzhand.xml \
    frameworks/native/data/etc/android.hardware.usb.accessory.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.usb.accessory.xml \
    frameworks/native/data/etc/android.hardware.usb.host.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.usb.host.xml \
    frameworks/native/data/etc/android.hardware.wifi.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.wifi.xml \
    frameworks/native/data/etc/android.hardware.location.gps.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.location.gps.xml

# ---------------------------------------------------------------------------------
# Media codecs
# ---------------------------------------------------------------------------------
# The Venus hardware video codecs, from hardware/qcom/media-caf/msm8952: the OMX core
# and its registry, the decoder and encoder components, and the stagefright plugin
# that makes them visible to the framework. libc2dcolorconvert converts the decoder's
# tiled output for clients that ask for plain YUV (thumbnails, for one) through the
# Adreno C2D blobs. The kernel side is msm_vidc (CONFIG_MSM_VIDC_V4L2), which loads
# the venus-v1 firmware on first use.
#
# media.msm8956hw tells the components they are on the 8956 Venus rather than the
# 8952's: higher H.264 levels, the downscaler, the encoder's 8956 restrictions. Stock
# set it from init.qcom.early_boot.sh by soc_id; this tablet is always an 8956.
#
# configs/media/media_codecs.xml lists what is declared and why; the measured frame
# rates (media_codecs_performance.xml) are stock's for this chip, see
# proprietary-files.txt.
PRODUCT_PACKAGES += \
    libc2dcolorconvert \
    libOmxCore \
    libOmxVdec \
    libOmxVenc \
    libstagefrighthw

PRODUCT_PROPERTY_OVERRIDES += \
    media.msm8956hw=1

# media.codec runs under a seccomp filter, and the components make a syscall Pie's
# policy does not allow: the first one to start killed the service, and every codec
# went with it, the Google ones included. The file says which and why.
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/seccomp/mediacodec.policy:$(TARGET_COPY_OUT_VENDOR)/etc/seccomp_policy/mediacodec.policy

PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/media/media_codecs.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_codecs.xml \
    frameworks/av/media/libstagefright/data/media_codecs_google_audio.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_codecs_google_audio.xml \
    frameworks/av/media/libstagefright/data/media_codecs_google_telephony.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_codecs_google_telephony.xml \
    frameworks/av/media/libstagefright/data/media_codecs_google_video.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_codecs_google_video.xml

# ---------------------------------------------------------------------------------
# Key layouts
# ---------------------------------------------------------------------------------
# Ours, two lines each; the files say why. Without gpio-keys.kl the home key did
# MOVE_HOME (Generic.kl's meaning of KEY_HOME) and the launcher just moved its focus.
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/keylayout/gpio-keys.kl:$(TARGET_COPY_OUT_VENDOR)/usr/keylayout/gpio-keys.kl \
    $(DEVICE_PATH)/configs/keylayout/atmel_mxt_ts.kl:$(TARGET_COPY_OUT_VENDOR)/usr/keylayout/atmel_mxt_ts.kl

# ---------------------------------------------------------------------------------
# Audio
# ---------------------------------------------------------------------------------
# The HAL is audio-caf/msm8952 built from source, not ASUS' Nougat blob. From the
# stock system come only the parts with no source: ASUS' mixer paths and platform
# info, the ACDB calibration loader and its data, and the ADSP firmware (see
# proprietary-files.txt). No optional HAL features yet (offload, fluence, speaker
# protection...): BoardConfig.mk turns them on one at a time once the base plays.
#
# This replaced a stub (audio.primary.default) that was there only so Pie could boot:
# with no audio HAL, audioserver dies on a null DevicesFactoryHal and system_server
# waits for media.audio_policy forever.
#
# Android 13: one service for every version of the audio HAL, and the 6.0 wrappers
# around the legacy module. Not 7.0: from that version the wrapper validates the policy
# file against a schema, and the CAF tree's file was written long before it.
PRODUCT_PACKAGES += \
    android.hardware.audio.service \
    android.hardware.audio@6.0-impl \
    android.hardware.audio.effect@6.0-impl \
    audio.a2dp.default \
    audio.primary.msm8952 \
    audio.r_submix.default \
    audio.usb.default \
    libaudio-resampler \
    libqcompostprocbundle \
    libqcomvisualizer \
    libqcomvoiceprocessing \
    tinymix

# The policy is the CAF tree's, which describes the outputs this HAL implements;
# ASUS' describes their own HAL. configs/audio has it with one port Android 13 cannot
# read, which made it throw the whole file away (the file says which). The effects are
# AOSP's: ASUS' audio_effects.conf loads Dolby and MaxxAudio libraries that are not
# here.
#
# audio.a2dp.default is the "a2dp" module of that policy: Bluetooth audio, handed to
# the Bluetooth stack over its sockets in /data/misc/bluedroid. Pie's base product
# installed it; Android 13's does not.
AUDIO_POLICY_CONFIG_DIR := frameworks/av/services/audiopolicy/config
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/audio/audio_policy_configuration.xml:$(TARGET_COPY_OUT_VENDOR)/etc/audio_policy_configuration.xml \
    $(AUDIO_POLICY_CONFIG_DIR)/a2dp_audio_policy_configuration.xml:$(TARGET_COPY_OUT_VENDOR)/etc/a2dp_audio_policy_configuration.xml \
    $(AUDIO_POLICY_CONFIG_DIR)/r_submix_audio_policy_configuration.xml:$(TARGET_COPY_OUT_VENDOR)/etc/r_submix_audio_policy_configuration.xml \
    $(AUDIO_POLICY_CONFIG_DIR)/usb_audio_policy_configuration.xml:$(TARGET_COPY_OUT_VENDOR)/etc/usb_audio_policy_configuration.xml \
    $(AUDIO_POLICY_CONFIG_DIR)/audio_policy_volumes.xml:$(TARGET_COPY_OUT_VENDOR)/etc/audio_policy_volumes.xml \
    $(AUDIO_POLICY_CONFIG_DIR)/default_volume_tables.xml:$(TARGET_COPY_OUT_VENDOR)/etc/default_volume_tables.xml \
    frameworks/av/media/libeffects/data/audio_effects.xml:$(TARGET_COPY_OUT_VENDOR)/etc/audio_effects.xml

# ---------------------------------------------------------------------------------
# WiFi
# ---------------------------------------------------------------------------------
# prima in the kernel, the rest from source: the WiFi HAL, wpa_supplicant, hostapd,
# and wcnss_service, which opens /dev/wcnss_wlan at boot so the WCNSS core is up
# before the HAL starts the driver. Built without QMI: the MAC address is the one
# ASUS wrote to /persist/wifi_mac.txt at the factory, handed to the WCNSS driver by
# configs/init.macaddr.sh (see the Bluetooth section). Without it prima would use the
# placeholder in WCNSS_qcom_cfg.ini, the same on every tablet.
#
# The three files prima asks the kernel for (wlan/prima/...) come from the stock
# system, see proprietary-files.txt. They go straight where request_firmware looks,
# rather than through the symlinks into /data and /persist that stock used.
PRODUCT_PACKAGES += \
    android.hardware.wifi@1.0-service \
    hostapd \
    libwpa_client \
    P00IWifiOverlay \
    wcnss_service \
    wificond \
    wpa_supplicant \
    wpa_supplicant.conf

PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/wifi/wpa_supplicant_overlay.conf:$(TARGET_COPY_OUT_VENDOR)/etc/wifi/wpa_supplicant_overlay.conf \
    $(DEVICE_PATH)/configs/wifi/p2p_supplicant_overlay.conf:$(TARGET_COPY_OUT_VENDOR)/etc/wifi/p2p_supplicant_overlay.conf

# ---------------------------------------------------------------------------------
# Bluetooth
# ---------------------------------------------------------------------------------
# The Bluetooth core is part of the WCNSS and talks over SMD. The HAL and libbt-vendor
# come from source; hci_qcomm_init, which configures the core, is a blob, and
# configs/bluetooth/init.bt.sh runs it when libbt-vendor asks (init.qcom.rc). The BD
# address is the one ASUS wrote at the factory: hci_qcomm_init reads it from the NV
# file in /persist through libbtnv, and configs/init.macaddr.sh writes it where the
# HAL looks (ro.bt.bdaddr_path) -- the HAL aborts without one. The same script gives
# WiFi its factory MAC; when /persist has lost either, it derives a stable one from the
# serial number (the modem's NV does not hold them on this tablet).
#
# ro.qualcomm.bt.hci_transport tells hci_qcomm_init the core is on SMD; without it it
# assumes a UART and waits for a /dev/ttyHS0 this tablet does not have.
PRODUCT_PROPERTY_OVERRIDES += \
    ro.qualcomm.bt.hci_transport=smd \
    ro.bt.bdaddr_path=/data/vendor/bluetooth/bdaddr

# The core says it filters advertisements, and Android 13 then asks it which extended
# filter features it has (LE_ADV_FILTER, opcode 0xfd57). The firmware of 2017 does not
# know the question and answers with opcode 0x0157; the stack asserts on the mismatch
# and the Bluetooth application dies in a loop. The stack in this tree has a property
# to not ask.
PRODUCT_PROPERTY_OVERRIDES += \
    bluetooth.le.disable_apcf_extended_features=1

# The profiles the Bluetooth stack offers. Up to Pie each was on unless an overlay
# turned it off; on Android 13 each is off unless a property turns it on, and with
# none set the stack offered GATT alone: headphones paired, and the tablet closed the
# connection a few seconds later. These are the classic profiles; the LE Audio
# ones need a controller newer than this one.
PRODUCT_PROPERTY_OVERRIDES += \
    bluetooth.profile.a2dp.source.enabled=true \
    bluetooth.profile.avrcp.target.enabled=true \
    bluetooth.profile.gatt.enabled=true \
    bluetooth.profile.hfp.ag.enabled=true \
    bluetooth.profile.hid.device.enabled=true \
    bluetooth.profile.hid.host.enabled=true \
    bluetooth.profile.map.server.enabled=true \
    bluetooth.profile.opp.enabled=true \
    bluetooth.profile.pan.nap.enabled=true \
    bluetooth.profile.pan.panu.enabled=true \
    bluetooth.profile.pbap.server.enabled=true

# Audio and video in step over Bluetooth. With the headphones' delay report, the A2DP
# module (audio.a2dp.default) told players about 650 ms of latency for earbuds that
# report 179 ms, and in the browser the sound ran 0.3 to 1 s ahead of the picture.
# With reports off it uses its own estimate (its buffer plus 200 ms), and the two were
# in step to the eye. Why the figure with reports was that high is not worked out.
PRODUCT_PROPERTY_OVERRIDES += \
    persist.bluetooth.disabledelayreports=true

PRODUCT_PACKAGES += \
    android.hardware.bluetooth@1.0-impl \
    android.hardware.bluetooth@1.0-service \
    libbt-vendor

PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/bluetooth/init.bt.sh:$(TARGET_COPY_OUT_VENDOR)/bin/init.bt.sh \
    $(DEVICE_PATH)/configs/init.macaddr.sh:$(TARGET_COPY_OUT_VENDOR)/bin/init.macaddr.sh \
    frameworks/native/data/etc/android.hardware.bluetooth_le.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.bluetooth_le.xml

# ---------------------------------------------------------------------------------
# RIL and the modem
# ---------------------------------------------------------------------------------
# rild and libril from hardware/ril-caf; qcril and the modem daemons are blobs (see
# proprietary-files.txt), started from init.qcom.rc. The properties are stock's and
# live in system.prop, since rild.libargs has a space in it.
PRODUCT_PACKAGES += \
    libril \
    librilutils \
    rild

# One symbol qcril wants from AudioSystem that Android 13 dropped; shims/ril says which.
PRODUCT_PACKAGES += \
    libshim_ril

# The apps and the feature that go with a SIM. This is AOSP's telephony.mk without the
# two packages that are about calls, Dialer and CallLogBackup: the modem does data and
# SMS and refuses voice calls in both directions, as ASUS sold it (overlay/ has the
# detail), and a Phone icon would promise what the tablet cannot do. Messaging, Stk
# and the APN list come from LineageOS' own telephony.mk.
#
# Android 13: cell broadcasts are a mainline module (com.android.cellbroadcast), which
# every product gets; there is no CellBroadcastReceiver package to ask for.
PRODUCT_PACKAGES += \
    CarrierConfig \
    CarrierDefaultApp \
    EmergencyInfo

PRODUCT_COPY_FILES += \
    frameworks/native/data/etc/android.hardware.telephony.gsm.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.telephony.gsm.xml

# ---------------------------------------------------------------------------------
# Sensors
# ---------------------------------------------------------------------------------
# AOSP's wrapper around the legacy sensors HAL, which is a blob (sensors.msm8952.so,
# see proprietary-files.txt); sensors.qcom, the daemon it talks to, starts from
# init.qcom.rc.
PRODUCT_PACKAGES += \
    android.hardware.sensors@1.0-impl \
    android.hardware.sensors@1.0-service

# ---------------------------------------------------------------------------------
# GPS
# ---------------------------------------------------------------------------------
# The GNSS engine is in the modem; the HAL talks to it over QMI. gps.msm8952 and its
# libraries are built from gps/ (tools/setup-gps.sh), AOSP's gnss@1.0 wraps the legacy
# HAL for the framework, and libloc_api_v02/libloc_ds_api, the QMI side, are blobs
# (proprietary-files.txt). gps.conf is ASUS' (XTRA servers, SUPL host).
#
# Not here: Qualcomm's IZat stack (network location from WiFi and cell towers,
# geofencing, FLP batching): a dozen blobs, two daemons and a privileged app, none of
# which a GPS fix needs.
PRODUCT_PACKAGES += \
    android.hardware.gnss@1.0-impl \
    android.hardware.gnss@1.0-service \
    gps.msm8952 \
    libgps.utils \
    libloc_core \
    libloc_eng

# ---------------------------------------------------------------------------------
# Camera
# ---------------------------------------------------------------------------------
# Rear Toshiba T4K35 (8 MP, dw9714 autofocus, le2464c eeprom), front OmniVision
# OV5670 (5 MP). The whole stack is ASUS' Nougat one, HAL included, because ASUS
# changed both ends of it: the HAL carries their DIT framework (ASUSDITInterface,
# arcsoft and face-beautify libraries) and the daemon's stats module links the same
# libxditk_ditBSP. The HAL and the daemon share Qualcomm's cam_intf structures, so a
# HAL from source (as kenzo builds QCamera2) would have to match ASUS' versions of
# them, and nothing says it does. The stack loads on Pie with one missing symbol,
# which shims/camera provides.
#
# AOSP's camera provider wraps the legacy HAL module for cameraserver. The HAL runs
# in HAL3 mode (persist.camera.HAL3.enabled; it defaults to HAL1, which does not work
# on Pie -- tools/extract-files.sh says why, and what the HAL is patched for). Both
# cameras report FULL with manual controls and RAW, and no flash, which is what the
# features say; stock declared flash-autofocus, which this tablet does not have. The
# other properties are stock's: the preview size limits the HAL applies, and
# monotonic timestamps for video.
PRODUCT_PACKAGES += \
    android.hardware.camera.provider@2.4-impl \
    android.hardware.camera.provider@2.4-service \
    libshim_camera

PRODUCT_PROPERTY_OVERRIDES += \
    persist.camera.HAL3.enabled=1 \
    camera.display.umax=1920x1080 \
    camera.display.lmax=1280x720 \
    camera.lowpower.record.enable=1 \
    media.camera.ts.monotonic=1

PRODUCT_COPY_FILES += \
    frameworks/native/data/etc/android.hardware.camera.autofocus.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.camera.autofocus.xml \
    frameworks/native/data/etc/android.hardware.camera.full.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.camera.full.xml \
    frameworks/native/data/etc/android.hardware.camera.raw.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.camera.raw.xml \
    frameworks/native/data/etc/android.hardware.camera.front.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.camera.front.xml

# ---------------------------------------------------------------------------------
# adb
# ---------------------------------------------------------------------------------
# Nothing set here. The build decides, from ro.adb.secure: development builds are made
# with WITH_ADB_INSECURE (no authorisation, which bring-up needed while the screen could
# not be trusted), and the build then turns adb on by default
# (build/make/tools/post_process_props.py). tools/release-build.sh makes them without
# it: ro.adb.secure=1, adb off until switched on in developer options, and the host's
# key to be accepted on the screen. ro.debuggable=1 comes with the userdebug variant.
# This block used to force persist.sys.usb.config=adb, which would have kept adb on in
# a release too.

# ---------------------------------------------------------------------------------
# USB HAL
# ---------------------------------------------------------------------------------
# Pie's Settings let the USB mode be chosen (file transfer, PTP, MIDI, tethering) only
# when a USB port reports the device data role, and ports come from the USB HAL; without
# one every option is greyed out. LineageOS's basic HAL reports one fixed port in device
# mode, which is all the gadget side needs. The FUSB302 Type-C driver does expose real
# roles in /sys/class/dual_role_usb/otg_default, for AOSP's default HAL, should role
# swapping from Settings ever be wanted; host mode (OTG) works without either.
# device/lineage/sepolicy labels it into hal_usb_default.
PRODUCT_PACKAGES += \
    android.hardware.usb@1.0-service.basic

