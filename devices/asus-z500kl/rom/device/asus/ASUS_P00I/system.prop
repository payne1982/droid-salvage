# System properties that cannot go through PRODUCT_PROPERTY_OVERRIDES: that is a make
# list, split on whitespace, and some values here contain spaces (rild.libargs). Read
# through TARGET_SYSTEM_PROP in BoardConfig.mk.

# RIL: rild loads qcril from here and passes it the SMD port, as stock did. Both the
# legacy and the vendor.-prefixed names, since ril-caf's rild reads one or the other
# depending on PRODUCT_COMPATIBLE_PROPERTY.
rild.libpath=/vendor/lib64/libril-qc-qmi-1.so
vendor.rild.libpath=/vendor/lib64/libril-qc-qmi-1.so
rild.libargs=-d /dev/smd0
vendor.rild.libargs=-d /dev/smd0

# Single SIM, LTE/GSM/WCDMA by default, mobile data through netmgrd: stock's values.
persist.radio.multisim.config=ss
ro.telephony.default_network=12
telephony.lteOnCdmaDevice=0
ro.use_data_netmgrd=true
persist.data.netmgrd.qos.enable=true
persist.data.mode=concurrent

# Keep the SIM powered in airplane mode, as stock's build.prop did. Otherwise qcril
# powers the card down, it reads absent until airplane mode ends, and then comes
# back as a newly inserted card.
persist.radio.apm_sim_not_pwdn=1

# Apps redraw their whole window on every frame instead of only what changed. With
# only the changed part redrawn, onto a buffer whose age the Nougat Adreno driver
# reports, bars and text fields flickered black for a frame (Messaging's toolbar,
# Chrome's address bar). Where exactly it goes wrong was not traced; other
# LineageOS 20 trees with drivers of that age set the same.
debug.hwui.use_buffer_age=false
