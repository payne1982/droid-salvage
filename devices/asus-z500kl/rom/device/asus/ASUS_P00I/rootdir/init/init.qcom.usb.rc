# USB gadget for ASUS_P00I, on the 4.9 kernel.
#
# The 4.9 kernel has no android_usb gadget; the gadget is built in ConfigFS, and the
# platform's init.usb.configfs.rc does the switching between compositions once
# sys.usb.configfs is 1 (functions linked into configs/b.1, then the UDC bound). What it
# leaves to the device is the gadget itself, its function instances under the names it
# links, and the name of the controller: msm_hsusb, as on the Xperia X, whose 4.9 kernel
# this one is.
#
# One product ID for every composition, ASUS's for MTP with adb. The 3.10 tree gave each
# composition its own, as stock did; the platform file binds the UDC in the same action
# that the composition is chosen in, before any device action could change the ID, and a
# bound gadget cannot take a new one. Hosts find MTP and adb by their interfaces anyway.

on init
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/idVendor 0x0B05
    write /config/usb_gadget/g1/idProduct 0x612F
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    mkdir /config/usb_gadget/g1/functions/ptp.gs1
    mkdir /config/usb_gadget/g1/functions/accessory.gs2
    mkdir /config/usb_gadget/g1/functions/audio_source.gs3
    mkdir /config/usb_gadget/g1/functions/rndis.gs4
    mkdir /config/usb_gadget/g1/functions/midi.gs5
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    setprop sys.usb.controller msm_hsusb

on fs
    # adbd's FunctionFS, under the name of the ffs.adb instance above, which has to
    # exist before this mount.
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000

on boot
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    # Overrides the 0 that init.usb.rc sets on init, as that file expects.
    setprop sys.usb.configfs 1
