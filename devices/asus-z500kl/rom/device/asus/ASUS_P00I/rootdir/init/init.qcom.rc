# Device init for ASUS_P00I (ASUS ZenPad 3S 10 LTE) on Pie.
#
# Ours, not ASUS'. The stock init.qcom.rc + init.target.rc are 1600 lines written for
# Nougat's init and pull in half a dozen more files; this starts from what Pie cannot
# boot without and grows one subsystem at a time, so that every line in here is one we
# have seen work.
#
# What Pie cannot boot without, learnt the hard way on the first M3 attempt: the core
# init.rc does not mount anything. Its `on fs` / `on late-fs` stages exist so that the
# device's init.${ro.hardware}.rc runs mount_all there, and with no such file /system
# and /data simply stay unmounted -- no adbd, no servicemanager, no surfaceflinger, the
# bootloader's ASUS logo forever, and nothing on USB to say why.
#
# ro.hardware is "qcom" (androidboot.hardware=qcom on the stock command line), which is
# why the file has this name.

import /init.qcom.usb.rc

on early-init
    # debugfs, as stock mounted it: system_server reads kernel wakelock statistics from
    # /d/wakeup_sources and logged a WTF at every boot without it, and the IPC router's
    # state (the QMI services each processor registered) is only visible here.
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug

    # Keep the Venus firmware loaded once it is. msm_vidc unloads it 15 s after the
    # last video session and loads it again on the next, into a 5 MB CMA region
    # (venus_mem) it needs whole. Early on that works; after a while in use, pages
    # there can no longer be moved out ("venus: Failed to allocate relocatable region
    # of size 500000"), and every hardware codec failed from then on -- first seen as
    # the camera recording with the software encoder. Loaded while the region is still
    # clean and never unloaded, it never has to be allocated again. An idle core is
    # power-collapsed either way (qcom,sw-power-collapse); unloading only saves the
    # region, which is reserved for it anyway.
    write /sys/kernel/debug/msm_vidc/firmware_unload_delay 4294967295

    # Mount points for the partitions fstab.qcom adds beyond AOSP's. The root
    # filesystem is still writable here; it is remounted read-only in post-fs.
    mkdir /firmware 0771 system system
    mkdir /persist 0771 system system
    mkdir /dsp 0771 media media

on init
    # Every path in fstab.qcom goes through /dev/block/bootdevice. Nougat's init made
    # that link itself from androidboot.bootdevice (7824900.sdhci on the stock command
    # line); Pie's ueventd does not -- it only makes /dev/block/by-name for the devices
    # in androidboot.boot_devices, which this bootloader does not pass. Without this line
    # mount_all waits 20 s for each partition and skips them all (second M3 attempt).
    symlink /dev/block/platform/soc.0/${ro.boot.bootdevice} /dev/block/bootdevice

on fs
    wait /dev/block/bootdevice
    mount_all /fstab.qcom

    restorecon_recursive /persist
    mkdir /persist/data 0700 system system

on early-boot
    # Start the audio DSP, as the stock init.qcom.rc did here. Nothing else does: with
    # no write the ADSP never boots and no sound card registers (/proc/asound/cards
    # empty). The firmware it loads is ASUS' copy in /system/etc/firmware, see
    # proprietary-files.txt. The sensors on this tablet go through the ADSP as well.
    write /sys/kernel/boot_adsp/boot 1
    chown root audio /sys/kernel/boot_adsp/boot

on boot
    # The WiFi HAL starts prima by writing the mode ("sta", "ap", "p2p") here, and it
    # runs as the wifi user; the parameter is root's by default ("Failed to open wlan
    # fw path param: Permission denied").
    chown wifi wifi /sys/module/wlan/parameters/fwpath
    chmod 0660 /sys/module/wlan/parameters/fwpath

    # Bluetooth on the WCNSS goes over these two SMD channels (ACL and commands); the
    # HAL and hci_qcomm_init run as bluetooth. ueventd leaves them root-only.
    chown bluetooth bluetooth /dev/smd2
    chmod 0660 /dev/smd2
    chown bluetooth bluetooth /dev/smd3
    chmod 0660 /dev/smd3

on post-fs-data
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    mkdir /persist/sensors 0775 system system
    mkdir /data/misc/sensors 0775 system system
    start vendor.macaddr

on post-fs-data
    # qcril's working files. It copies the prebuilt vendor/qcril.db here once
    # prebuilt_db_support says it may, and keeps its own state alongside.
    mkdir /data/misc/radio 0770 system radio
    mkdir /data/misc/radio/modem_config 0770 radio radio
    write /data/misc/radio/copy_complete 0
    chown radio radio /data/misc/radio/copy_complete
    chmod 0660 /data/misc/radio/copy_complete
    write /data/misc/radio/prebuilt_db_support 1
    chown radio radio /data/misc/radio/prebuilt_db_support
    chmod 0400 /data/misc/radio/prebuilt_db_support
    write /data/misc/radio/db_check_done 0
    chown radio radio /data/misc/radio/db_check_done
    chmod 0660 /data/misc/radio/db_check_done
    mkdir /data/misc/netmgr 0770 radio radio

on post-fs-data
    # The GPS HAL's working directory, as stock made it: it keeps XTRA's state in
    # xtra/, which it creates itself and could not without this ("make XTRA_FOLDER
    # failed"). The HAL runs as gps.
    mkdir /data/misc/location 0770 gps gps

on boot
    # The QMI multiplexer's sockets and netmgrd's, created as stock did.
    mkdir /dev/socket/qmux_radio 0770 radio radio
    chmod 2770 /dev/socket/qmux_radio
    mkdir /dev/socket/qmux_audio 0770 media audio
    chmod 2770 /dev/socket/qmux_audio
    mkdir /dev/socket/qmux_bluetooth 0770 bluetooth bluetooth
    chmod 2770 /dev/socket/qmux_bluetooth
    mkdir /dev/socket/qmux_gps 0770 gps gps
    chmod 2770 /dev/socket/qmux_gps
    mkdir /dev/socket/netmgr 0750 radio radio

# libbt-vendor asks for the Bluetooth core with vendor.bluetooth.hciattach=true and
# waits for vendor.bluetooth.status=on, which init.bt.sh sets.
on property:vendor.bluetooth.hciattach=true
    start vendor.hciattach

on property:vendor.bluetooth.hciattach=false
    setprop vendor.bluetooth.status off

on post-fs-data
    mkdir /data/tombstones 0771 system system
    mkdir /data/vendor/tombstones 0771 system system
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

# The TrustZone listener daemon. The keymaster (keystore.msm8952.so) and with it
# keystore, gatekeeper and disk encryption all go through it: without it keystore never
# registers and system_server dies on a null IKeystoreService in TrustManagerService
# (fifth M3 attempt). Same definition as the stock init.target.rc. It needs /firmware
# (the keymaster trustlet), /persist and /dev/block/bootdevice (librpmb), all of which
# are in place by the time class core starts.
service qseecomd /system/bin/qseecomd
    class core
    user root
    group root

# Opens /dev/wcnss_wlan, which is what powers the WCNSS core up and downloads its
# firmware and NV calibration; prima refuses to start before that ("WCNSS driver not
# ready"). It also copies WCNSS_qcom_cfg.ini to /data/vendor/wifi if one is shipped in
# /vendor/etc/wifi, which this device does not need.
service wcnss-service /system/bin/wcnss_service
    class main
    user system
    group system wifi radio
    disabled
    oneshot

# The supplicant, also serving the HIDL supplicant interface the framework uses. One
# instance for wlan0 and p2p0 (-g with the control socket, interfaces added over HIDL).
service wpa_supplicant /system/vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service vendor.hciattach /system/bin/sh /system/vendor/bin/init.bt.sh
    class late_start
    user bluetooth
    group bluetooth net_bt_admin system
    disabled
    oneshot

# WiFi and Bluetooth addresses, from /persist or failing that from the serial number,
# before either is switched on; it also starts wcnss_service. See the script.
service vendor.macaddr /system/bin/sh /system/vendor/bin/init.macaddr.sh
    class main
    user root
    group root bluetooth
    disabled
    oneshot

# The modem's userspace, as stock ran it (its init.qcom.rc and init.target.rc). The
# modem does not boot by itself: it needs its EFS served (rmt_storage, tftp_server)
# and the peripheral manager's vote (per_mgr). qmuxd and netmgrd were started by a
# stock shell script depending on the baseband; this device has one baseband, so they
# start with their class. rild itself comes with ril-caf's own rild.rc.
# Stock also listed the qcom_diag group, which does not exist in Pie and would make
# init reject the whole service; it only matters for the diag logging port.
service rmt_storage /system/bin/rmt_storage
    class core
    user root

service tftp_server /system/bin/tftp_server
    class main
    user root

service irsc_util /system/bin/irsc_util "/etc/sec_config"
    class main
    user root
    oneshot

service per_mgr /system/bin/pm-service
    class core
    user system
    group system net_raw

service per_proxy /system/bin/pm-proxy
    class core
    user system
    group system
    disabled

on property:init.svc.per_mgr=running
    start per_proxy

on property:sys.shutdown.requested=*
    stop per_proxy

service qmuxd /system/bin/qmuxd
    class main
    user root
    group radio audio bluetooth gps

service netmgrd /system/bin/netmgrd
    class main

# The sensor daemon: it talks to the sensor subsystem on the ADSP over QMI and serves
# the socket the sensors HAL connects to.
#
# Group 3011 is Qualcomm's "sensors" group, and the only one etc/sec_config lets talk to
# the sensor services on the ADSP (256-273). The daemon starts as root and drops to the
# "sensors" user by name; Pie has no such user, so it ends up as nobody and the IPC
# router refuses its messages ("xport_send: Sendto failed", no sensors at all). Given
# the group number here, as a supplementary group, it keeps it.
service sensors /system/bin/sensors.qcom
    class late_start
    user root
    group root 3011

# The camera daemon: ASUS' mm-qcamera-daemon, which owns the sensors, the ISP and the
# post-processing pipeline and serves the HAL. Same definition as the stock
# init.target.rc. It probes the sensors itself when it starts (sensor_init), so the
# kernel log only shows "probe succeeded" once it has run.
service qcamerasvr /system/bin/mm-qcamera-daemon
    class late_start
    user camera
    group camera system inet input graphics

on post-fs-data
    mkdir /data/misc/camera 0770 camera camera
    mkdir /data/camera 0770 media camera
