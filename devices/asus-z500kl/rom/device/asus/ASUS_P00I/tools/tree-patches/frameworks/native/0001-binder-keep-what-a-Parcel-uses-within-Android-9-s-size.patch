+++ b/libs/binder/Parcel.cpp
@@ -305,6 +305,13 @@ status_t Parcel::unflattenBinder(sp<IBinder>* out) const
 
 Parcel::Parcel()
 {
+    // What is used of a Parcel has to fit in what code built against the header of
+    // Android 9 and earlier reserves for one; Parcel.h says who does.
+#ifdef __LP64__
+    static_assert(sizeof(Parcel) - sizeof(mUnused) <= 104);
+#else
+    static_assert(sizeof(Parcel) - sizeof(mUnused) <= 52);
+#endif
     LOG_ALLOC("Parcel %p: constructing", this);
     initState();
 }
