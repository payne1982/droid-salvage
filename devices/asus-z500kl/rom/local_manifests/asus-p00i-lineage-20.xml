<?xml version="1.0" encoding="UTF-8"?>
<!--
     What ASUS_P00I needs in a LineageOS-UL lineage-20.0 tree beyond its own three
     directories (device, kernel, vendor). Copy this file to .repo/local_manifests/
     before the sync, next to lineage-20-forks.xml.

     The audio, display and media HALs for the msm8952 platform. LineageOS built them
     from source up to 18.1 and then dropped the platform, so lineage-20.0 has no
     hardware/qcom-caf/msm8952 at all. Audio and media are LineageOS' last branches;
     display is LineageOS-UL's, which is that same branch with the four changes it needs
     to build on Android 12 and later. This is the set the Galaxy Tab S2 (MSM8976) is
     built with on LineageOS 20.

     hardware/qcom-caf/common is declared again only to add one line: the Android.mk
     that keeps a platform's directory out of the build unless the product asks for it,
     here for msm8952. The rest of the entry is the manifest's own.
-->
<manifest>
  <project path="hardware/qcom-caf/msm8952/audio" name="LineageOS/android_hardware_qcom_audio" revision="lineage-18.1-caf-msm8952" groups="qcom,qcom_audio" />
  <project path="hardware/qcom-caf/msm8952/display" name="LineageOS-UL/android_hardware_qcom_display" revision="lineage-20.0-caf-msm8952" groups="qcom,qcom_display" />
  <project path="hardware/qcom-caf/msm8952/media" name="LineageOS/android_hardware_qcom_media" revision="lineage-18.1-caf-msm8952" groups="qcom" />

  <remove-project name="LineageOS/android_hardware_qcom-caf_common" />
  <project path="hardware/qcom-caf/common" name="LineageOS/android_hardware_qcom-caf_common" groups="qcom" >
    <!-- add guard for AOSP hardware/qcom dir -->
    <linkfile src="os_pickup_aosp.mk" dest="hardware/qcom/Android.mk" />
    <!-- add guards for CAF repositories -->
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/msm8952/Android.mk" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/msm8974/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/msm8953/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/msm8953/Android.mk" />
    <linkfile src="os_pickup.bp" dest="hardware/qcom-caf/msm8996/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/msm8996/Android.mk" />
    <linkfile src="os_pickup.bp" dest="hardware/qcom-caf/msm8998/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/msm8998/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm660/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/sdm660/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm845/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/sdm845/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8150/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/sm8150/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8250/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/sm8250/Android.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8350/Android.bp" />
    <linkfile src="os_pickup.mk" dest="hardware/qcom-caf/sm8350/Android.mk" />
    <linkfile src="os_pickup.bp" dest="vendor/nxp/opensource/pn5xx/Android.bp" />
    <linkfile src="os_pickup.mk" dest="vendor/nxp/opensource/pn5xx/Android.mk" />
    <linkfile src="os_pickup.bp" dest="vendor/nxp/opensource/sn100x/Android.bp" />
    <linkfile src="os_pickup.mk" dest="vendor/nxp/opensource/sn100x/Android.mk" />
  </project>
</manifest>
