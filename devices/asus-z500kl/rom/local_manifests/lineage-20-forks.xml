  <remove-project name="platform/packages/modules/IntentResolver" />
  <project path="packages/modules/IntentResolver" name="LineageOS/android_packages_modules_IntentResolver" groups="pdk" />
  <remove-project name="platform/packages/services/BuiltInPrintService" />
  <project path="packages/services/BuiltInPrintService" name="LineageOS/android_packages_services_BuiltInPrintService" groups="pdk-cw-fs,pdk-fs" />
