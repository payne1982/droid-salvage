Subject: [PATCH] mm-video-v4l2: vidc: the 4.9 kernel's session close and flush events

For LineageOS/android_hardware_qcom_media, lineage-18.1-caf-msm8952, at
hardware/qcom-caf/msm8952/media. Enabled by TARGET_USES_Z500KL_VENUS_49, with the
kernel's patches/0029: the components close their sessions with its private command,
and read which queue a flush completed. Without the flag they build as before.
---
--- a/mm-video-v4l2/vidc/common/Android.mk
+++ b/mm-video-v4l2/vidc/common/Android.mk
@@ -15,6 +15,10 @@
 libmm-vidc-def += -D_ANDROID_
 libmm-vidc-def += -Werror
 libmm-vidc-def += -D_ANDROID_ICS_
+
+ifeq ($(TARGET_USES_Z500KL_VENUS_49),true)
+libmm-vidc-def += -DZ500KL_VENUS_49
+endif
 
 # ---------------------------------------------------------------------------------
 # 			Make the Shared library (libOmxVidcCommon)
--- /dev/null
+++ b/mm-video-v4l2/vidc/common/inc/z500kl_venus_compat.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef Z500KL_VENUS_COMPAT_H
+#define Z500KL_VENUS_COMPAT_H
+
+#include <linux/videodev2.h>
+
+/* Enable only for the matching
+ * candidate 4.9 driver. Shared control IDs, enums, buffer flags and extradata
+ * layouts must come from that driver's headers, never copied 3.10 headers.
+ */
+#ifdef Z500KL_VENUS_49
+#include <media/msm_vidc_z500kl.h>
+
+#define Z500KL_VDEC_SESSION_CLOSE MSM_VIDC_Z500KL_CMD_SESSION_CLOSE
+#define Z500KL_VENC_SESSION_CLOSE MSM_VIDC_Z500KL_CMD_SESSION_CLOSE
+#define V4L2_EVENT_MSM_VIDC_CLOSE_DONE MSM_VIDC_Z500KL_EVENT_SESSION_CLOSE_DONE
+
+#ifndef V4L2_DEC_QCOM_CMD_FLUSH
+#define V4L2_DEC_QCOM_CMD_FLUSH V4L2_QCOM_CMD_FLUSH
+#endif
+#ifndef V4L2_ENC_QCOM_CMD_FLUSH
+#define V4L2_ENC_QCOM_CMD_FLUSH V4L2_QCOM_CMD_FLUSH
+#endif
+#ifndef V4L2_DEC_QCOM_CMD_FLUSH_OUTPUT
+#define V4L2_DEC_QCOM_CMD_FLUSH_OUTPUT V4L2_QCOM_CMD_FLUSH_OUTPUT
+#endif
+#ifndef V4L2_DEC_QCOM_CMD_FLUSH_CAPTURE
+#define V4L2_DEC_QCOM_CMD_FLUSH_CAPTURE V4L2_QCOM_CMD_FLUSH_CAPTURE
+#endif
+#ifndef V4L2_CID_MPEG_VIDC_VIDEO_H264_AU_DELIMITER
+#define V4L2_CID_MPEG_VIDC_VIDEO_H264_AU_DELIMITER V4L2_CID_MPEG_VIDC_VIDEO_AU_DELIMITER
+#define V4L2_MPEG_VIDC_VIDEO_H264_AU_DELIMITER_DISABLED V4L2_MPEG_VIDC_VIDEO_AU_DELIMITER_DISABLED
+#define V4L2_MPEG_VIDC_VIDEO_H264_AU_DELIMITER_ENABLED V4L2_MPEG_VIDC_VIDEO_AU_DELIMITER_ENABLED
+#endif
+
+#else
+#define Z500KL_VDEC_SESSION_CLOSE V4L2_DEC_CMD_STOP
+#define Z500KL_VENC_SESSION_CLOSE V4L2_ENC_CMD_STOP
+#endif
+
+/* Native 4.9 flush events identify which queue completed. The driver's
+ * invalid-state flush deliberately has a zero payload and completes both.
+ * Legacy ASUS clients received one aggregate completion.
+ */
+static inline unsigned int z500kl_venus_flush_mask(const struct v4l2_event *event)
+{
+    const unsigned int both = V4L2_QCOM_CMD_FLUSH_OUTPUT | V4L2_QCOM_CMD_FLUSH_CAPTURE;
+#ifdef Z500KL_VENUS_49
+    unsigned int mask = 0;
+    __builtin_memcpy(&mask, event->u.data, sizeof(mask));
+    return mask ? (mask & both) : both;
+#else
+    (void)event;
+    return both;
+#endif
+}
+#endif
--- a/mm-video-v4l2/vidc/vdec/Android.mk
+++ b/mm-video-v4l2/vidc/vdec/Android.mk
@@ -25,6 +25,11 @@
