# The by-name symlinks are created by ueventd from the platform device path.
# This kernel is 3.10 and reports the old-style /devices/soc.0/... paths, which a
# Pie-era ueventd may not match, leaving /dev/block/bootdevice/by-name empty. So
# name the raw mmcblk nodes (always created by the kernel) as the primary device
# and keep by-name as the alternate.
#
# mount point  fstype  device                 device2                                      flags
/boot          emmc    /dev/block/mmcblk0p41  /dev/block/bootdevice/by-name/boot           flags=display="Boot";backup=1;flashimg=1
/recovery      emmc    /dev/block/mmcblk0p43  /dev/block/bootdevice/by-name/recovery       flags=display="Recovery";backup=1;flashimg=1
/system        ext4    /dev/block/mmcblk0p44  /dev/block/bootdevice/by-name/system         flags=display="System"
/system_image  emmc    /dev/block/mmcblk0p44  /dev/block/bootdevice/by-name/system         flags=display="System Image";backup=1;flashimg=1
/cache         ext4    /dev/block/mmcblk0p36  /dev/block/bootdevice/by-name/cache          flags=display="Cache"
/data          ext4    /dev/block/mmcblk0p45  /dev/block/bootdevice/by-name/userdata       flags=encryptable=footer;length=-16384
/persist       ext4    /dev/block/mmcblk0p5   /dev/block/bootdevice/by-name/persist        flags=display="Persist";backup=1
/firmware      vfat    /dev/block/mmcblk0p1   /dev/block/bootdevice/by-name/modem          flags=display="Firmware";mounttodecrypt;fsflags=ro
/misc          emmc    /dev/block/mmcblk0p11  /dev/block/bootdevice/by-name/misc           flags=display="Misc"

# EFS / modem calibration (IMEI etc.) - image-only, for backup
/efs1          emmc    /dev/block/mmcblk0p9   /dev/block/bootdevice/by-name/modemst1       flags=display="EFS";backup=1
/efs2          emmc    /dev/block/mmcblk0p10  /dev/block/bootdevice/by-name/modemst2       flags=backup=1;subpartitionof=/efs1
/efsg          emmc    /dev/block/mmcblk0p3   /dev/block/bootdevice/by-name/fsg            flags=backup=1;subpartitionof=/efs1
/asus_nvm      emmc    /dev/block/mmcblk0p4   /dev/block/bootdevice/by-name/asus_nvm       flags=backup=1;subpartitionof=/efs1

# Removable storage
/external_sd   vfat    /dev/block/mmcblk1p1   /dev/block/mmcblk1                           flags=display="Micro SD";storage;wipeingui;removable
/usb-otg       vfat    /dev/block/sda1        /dev/block/sda                               flags=display="USB OTG";storage;wipeingui;removable
